{
    "name": "super-bowl-squares",
    "version": "0.0.2",
    "description": "🏈 super bowl squares",
    "type": "module",
    "keywords": [
        "typescript",
        "react",
        "eslint",
        "prettier",
        "vitest",
        "cloudflare",
        "react-router",
        "tailwind",
        "sqlite",
        "drizzle",
        "hacktoberfest"
    ],
    "homepage": "https://github.com/bradgarropy/super-bowl-squares",
    "bugs": {
        "url": "https://github.com/bradgarropy/super-bowl-squares/issues"
    },
    "license": "MIT",
    "author": {
        "name": "Brad Garropy",
        "email": "bradgarropy@gmail.com",
        "url": "https://bradgarropy.com"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/bradgarropy/super-bowl-squares"
    },
    "scripts": {
        "build": "react-router build",
        "contributors": "all-contributors generate",
        "db:check": "drizzle-kit check",
        "db:generate": "drizzle-kit generate",
        "db:migrate:dev": "wrangler d1 migrations apply DB --local",
        "db:migrate:prod": "wrangler d1 migrations apply DB --remote",
        "db:migrate:staging": "wrangler d1 migrations apply DB --remote --env staging",
        "db:seed": "tsx src/db/seed.ts",
        "format": "prettier --check .",
        "format:fix": "prettier --write .",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "preview": "npm run build && vite preview",
        "start": "react-router dev",
        "test": "vitest --coverage",
        "test:watch": "vitest --coverage --watch",
        "typecheck": "npm run typegen && tsc",
        "typegen": "react-router typegen && wrangler types"
    },
    "dependencies": {
        "@heroicons/react": "^2.1.1",
        "array-shuffle": "^3.0.0",
        "bcryptjs": "^2.4.3",
        "clsx": "^2.1.1",
        "drizzle-orm": "^0.45.2",
        "isbot": "^5.1.1",
        "react": "^19.2.8",
        "react-dom": "^19.2.8",
        "react-router": "^8.3.0",
        "tailwind-merge": "^3.6.0"
    },
    "devDependencies": {
        "@bradgarropy/eslint-config": "^1.2.3",
        "@bradgarropy/eslint-config-react": "^1.1.0",
        "@bradgarropy/eslint-config-typescript": "^1.2.0",
        "@cloudflare/vite-plugin": "^1.54.0",
        "@react-router/dev": "^8.3.0",
        "@testing-library/dom": "^10.4.1",
        "@testing-library/react": "^16.3.2",
        "@tailwindcss/vite": "^4.3.3",
        "@types/bcryptjs": "^2.4.6",
        "@types/node": "^24.13.3",
        "@types/react": "^19.2.18",
        "@types/react-dom": "^19.2.5",
        "@typescript-eslint/eslint-plugin": "^6.21.0",
        "@typescript-eslint/parser": "^6.21.0",
        "@vitejs/plugin-react": "^6.1.0",
        "@vitest/coverage-v8": "^4.1.11",
        "all-contributors-cli": "^6.26.1",
        "drizzle-kit": "^0.31.10",
        "eslint": "^8.56.0",
        "eslint-config-prettier": "^9.1.0",
        "eslint-plugin-jsx-a11y": "^6.10.2",
        "eslint-plugin-react": "^7.37.5",
        "eslint-plugin-react-hooks": "^4.6.2",
        "eslint-plugin-simple-import-sort": "^12.0.0",
        "jsdom": "^24.0.0",
        "prettier": "^3.1.1",
        "tailwindcss": "^4.3.3",
        "tsx": "^4.23.12",
        "typescript": "^5.9.3",
        "vite": "^8.2.2",
        "vite-plugin-devtools-json": "^1.1.0",
        "vitest": "^4.1.11",
        "wrangler": "^4.126.0"
    },
    "engines": {
        "node": ">=24"
    },
    "sideEffects": false
}
